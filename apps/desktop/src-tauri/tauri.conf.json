{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MICRIX",
  "version": "0.1.1",
  "identifier": "com.micrix.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MICRIX",
        "width": 1120,
        "height": 760,
        "minWidth": 1120,
        "minHeight": 760,
        "maxWidth": 1120,
        "maxHeight": 760,
        "resizable": false,
        "maximizable": false,
        "fullscreen": false,
        "theme": "Dark",
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
