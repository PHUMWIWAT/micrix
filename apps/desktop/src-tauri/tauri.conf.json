{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MICRIX",
  "version": "0.1.3",
  "identifier": "com.micrix.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MICRIX",
        "width": 1120,
        "height": 760,
        "minWidth": 1120,
        "minHeight": 760,
        "maxWidth": 1120,
        "maxHeight": 760,
        "resizable": false,
        "maximizable": false,
        "fullscreen": false,
        "theme": "Dark",
        "visible": false
      },
      {
        "label": "toast",
        "url": "toast.html",
        "title": "MICRIX",
        "width": 280,
        "height": 84,
        "visible": false,
        "decorations": false,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "closable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focusable": false,
        "focus": false,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
